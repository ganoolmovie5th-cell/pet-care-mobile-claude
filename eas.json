{
  "cli": {
    "version": ">= 5.0.0"
  },
  "build": {
    "production": {
      "channel": "production",
      "distribution": "store",
      "ios": {
        "buildType": "archive"
      },
      "android": {
        "buildType": "aab"
      }
    },
    "preview": {
      "channel": "preview",
      "distribution": "internal"
    },
    "internal": {
      "channel": "internal",
      "distribution": "internal"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleTeamId": "APPLE_TEAM_ID",
        "appleId": "apple-id@example.com",
        "ascAppId": "APPLE_APP_ID",
        "sku": "com.petcare.mobile"
      },
      "android": {
        "serviceAccount": "keys/google-play-key.json",
        "track": "production"
      }
    },
    "internal": {
      "android": {
        "serviceAccount": "keys/google-play-key.json",
        "track": "internal"
      }
    }
  }
}
